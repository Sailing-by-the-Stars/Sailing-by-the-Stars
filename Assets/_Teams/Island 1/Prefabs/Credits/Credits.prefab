  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "CREDITS\n\nART\r\nRokas (Art Lead)\r\nKaro Tran (Scrum Master & Senior
    Artist)\r\nAnastasia Lukanova (Scrum Master & Junior Artist)\r\nElin Graafland
    (Senior Artist)\r\nRafaella Nikolaou (Senior Artist)\r\nRenardo\t(Senior Artist)\r\nYoana
    Terzieva (Senior Artist)\r\nSaule Juce (Junior Artist)\r\nYke Kroon (Junior Artist)\r\nSem
    Jager (Sound Designer/Composer)\r\n\r\nDESIGN\r\nNiels Andela (Lead Designer
    & Marketer)\r\nIasmin Mambet (Lead Designer)\r\nHelena De Melo (Scrum Master
    & Senior Designer)\r\nTycho de Krou (Scrum Master Senior Designer)\r\nMarsha
    Zeldenrust (Senior Designer)\r\nYuki Bolt (Senior Designer)\r\nChristoph J. Brogle
    (Junior Designer, Release Manager & Marketer)\r\nKarel Bruijn (Junior Designer)\r\nNefeli
    Chrysostomou (Junior Designer)\r\nOzan Nail (Junior Designer)\r\nVictor Holman
    (Junior Designer)\r\nSofia Avakian (UX/UI Designer)\r\n\r\nVERSION CONTROL &
    DEVELOPMENT\r\nJantina Mulder (Lead Developer & Scrum Master)\r\nJoost Wolters
    (Lead Developer)\r\nTimofei Arefev\t(Scrum Master & Junior Developer)\r\nAlonso
    C\xE1ceres Garcia (Senior Developer)\r\nEduard Ciofu (Senior Developer)\r\nJardi
    Wester (Senior Developer)\r\nJohan (Senior Developer)\r\nSander Kleine (Semi-Senior
    Developer)\r\nAlice Tel (Junior Developer)\r\nArch Promchan (Junior Developer)\r\nBoas
    Idema (Junior Developer)\r\nChristina Pence (Junior Developer)\r\nJo\xEBl Misiedjan
    (Junior Developer)\r\nNikolay Minins (Junior Developer\r\nTies Medemblik (Junior
    Developer)\r\nVasilis Vlachos (Junior Developer)\r\n"
  m_isRightToLeft: 0
