  m_Script: {fileID: 11500000, guid: a232151ded5f93a43bc44dbd17b053b5, type: 3}
  m_Name: DenialNote2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNoteData
  dialogue: {fileID: 11400000, guid: 3f9f95eb1d9236f4cb9f481ba8f2416e, type: 2}
  pageGroupID: DenialNote2
  noteText: "After the second time speaking to them they gave me much more helpful
    information.\r\nThey really wanted me to explore the islands, I should make that
    my main priority\r\nAccording to the being I can find items on these islands,
    I wonder what specific purpose they\r\nhave\u2026 I hope they can help me find
    a way back!\r\nThey also mentioned something more sinister\u2026\r\nThey mentioned
    that at the end of my journey something awaits me\u2026"
