  - text: "Press \u201CJ\u201D to open your journal  "
    waitAtLineEnd: 0
    waitForTutorial: 1
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: "Use \u201CE\u201D and \u201CQ\u201D to navigate the pages"
    waitAtLineEnd: 0
    waitForTutorial: 1
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: Journal, Assembly-CSharp
          m_MethodName: EnableControl
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 1
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: "Use \u201CZ\u201D to zoom in"
    waitAtLineEnd: 1
    waitForTutorial: 0
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: Journal, Assembly-CSharp
          m_MethodName: EnableControl
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Directions you find to other islands will be kept in the journal '
    waitAtLineEnd: 1
    waitForTutorial: 0
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Find the described star in the sky and align your Astrolabe with it '
    waitAtLineEnd: 1
    waitForTutorial: 0
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Use the Celestial Map, as well as other constellations, to find the star
      you are looking for '
    waitAtLineEnd: 0
    waitForTutorial: 1
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: You have found the star! Move towards it till you're at the correct angle
    waitAtLineEnd: 1
    waitForTutorial: 0
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Board the boat and follow the instruction in the journal to reach the
      next island. Good luck! '
    waitAtLineEnd: 1
    waitForTutorial: 0
    lineToGoToNext: -1
    startOfLine:
      m_PersistentCalls:
        m_Calls: []
    endOfLine:
      m_PersistentCalls:
        m_Calls: []
  currentSequence: {fileID: 0}
  currentTutorialStep: -1
